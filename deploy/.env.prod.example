# Copia este archivo como .env en la raíz del repo (en el servidor) y completa los valores.
# Genera cada secreto con:  openssl rand -hex 24
# Cada ambiente (producción, QA, dev) tiene su carpeta y su propio .env, con secretos distintos:
# ver docs/ambientes.md.

# Qué ambiente es esta carpeta: prod (o sin definir), qa o dev.
AMBIENTE=prod

# Dominio de este ambiente, sin https:// (producción app.formsis.com, QA qa.formsis.com, dev dev.formsis.com).
# Sin dominio propio sirve uno gratis de sslip.io con la IP escrita con guiones, por ejemplo 34-176-10-20.sslip.io
DOMINIO=

# --- Solo en el .env de producción (el Caddy de producción atiende a todos los ambientes) ---
# Dominios viejos que redirigen a DOMINIO, separados por espacios.
# DOMINIO_ANTERIOR=prueba.formsis.com
# Dominio del sitio de presentación (repo formsis-web). Si no se define, es formsis.com.
# DOMINIO_WEB=formsis.com
# Dominios de QA y dev. Si no se definen, son qa.formsis.com y dev.formsis.com.
# DOMINIO_QA=qa.formsis.com
# DOMINIO_DEV=dev.formsis.com
# IPs que pueden entrar a QA y dev, separadas por espacios (una IP sola o un rango como 181.1.2.0/24).
# Sin definir no entra nadie. Tu IP pública: https://ifconfig.me
IPS_PERMITIDAS=

# --- Solo en QA y dev ---
# Puerto local de la consola de MinIO, distinto en cada ambiente (producción usa 9001).
# PUERTO_CONSOLA_MINIO=9002

POSTGRES_PASSWORD=
MINIO_ROOT_USER=formsis
MINIO_ROOT_PASSWORD=
# Token compartido entre la API y el servicio de prueba de vida
FACE_TOKEN=

# Cuenta inicial del panel (se crea al arrancar si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ORG_NAME=Mi organización

# SMTP para emails (enlaces mágicos, invitaciones, acuses). Obligatorio: sin SMTP la API no arranca,
# porque los enlaces de acceso quedarían escritos en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Formsis <no-reply@tu-dominio.com>
