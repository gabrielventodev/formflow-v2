# Caddy pide y renueva solo los certificados https (Let's Encrypt) de cada dominio.
# Atiende los dos ambientes (ver docs/ambientes.md): producción en DOMINIO y QA en DOMINIO_QA,
# cada uno con su propia web, además del sitio de presentación.
# La web de Next.js de cada ambiente atiende todo, incluida la API en /api/v1 (la reenvía a la API en Go).
{
	servers {
		# Rangos de Cloudflare (https://www.cloudflare.com/ips/). Cuando el tráfico pasa por su proxy,
		# Caddy toma la IP real del visitante de CF-Connecting-IP solo si la conexión viene de uno de
		# estos rangos; cualquier otro que mande esa cabecera queda con su propia IP. Así la restricción
		# por IP de QA y los límites de intentos de la API funcionan igual con o sin Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

# Cabeceras de seguridad de la app, compartidas por los dos ambientes. La CSP deja todo en el mismo dominio y permite:
# - 'unsafe-inline' en scripts y estilos, porque Next.js mete scripts en línea al renderizar;
# - data: y blob: en imágenes, para el QR de la prueba de vida y las miniaturas de archivos subidos;
# - blob: en object/frame/media, para abrir en otra pestaña los PDF e imágenes subidos.
# La cámara de la prueba de vida la controla Permissions-Policy (camera=(self)), no la CSP.
(app) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'self' blob:; frame-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}

	request_body {
		max_size 60MB
	}

	# La API limita intentos por IP con la última entrada de X-Forwarded-For. Se reemplaza por la IP
	# real ya resuelta (también detrás de Cloudflare), en vez de agregarla al final de la que llega.
	reverse_proxy {args[0]}:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# QA: solo entran las IPs de IPS_PERMITIDAS; el resto recibe 403. Tampoco se indexan en buscadores.
(solo_ips_permitidas) {
	@bloqueado not client_ip {$IPS_PERMITIDAS:127.0.0.1/32}
	respond @bloqueado "Acceso restringido" 403 {
		close
	}
	header X-Robots-Tag "noindex, nofollow"
}

# Producción. Los dominios de DOMINIO_ANTERIOR (por ejemplo prueba.formsis.com) redirigen acá.
{$DOMINIO} {$DOMINIO_ANTERIOR} {
	@anterior not host {$DOMINIO}
	redir @anterior https://{$DOMINIO}{uri} permanent

	import app web-prod
}

{$DOMINIO_QA:qa.formsis.com} {
	import solo_ips_permitidas
	import app web-qa
}

# Sitio de presentación (HTML estático del repo formsis-web, clonado en ../formsis-web)
# en el dominio raíz, por defecto formsis.com.
# Necesita en el DNS un registro A de @ (y de www) a la IP del servidor; mientras no exista,
# Caddy solo reintenta el certificado de este dominio y la app sigue funcionando igual.
{$DOMINIO_WEB} {
	encode zstd gzip

	# Sin scripts ni estilos en línea, así que la CSP es más estricta que la de la app.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	@recursos path /fuentes/* /img/* /estilos.css /app.js
	header @recursos Cache-Control "public, max-age=3600"

	root * /srv/sitio
	# URLs sin .html: /terminos sirve terminos.html.
	try_files {path} {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMINIO_WEB} {
	redir https://{$DOMINIO_WEB}{uri} permanent
}
