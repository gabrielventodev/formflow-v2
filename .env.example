POSTGRES_PASSWORD=formflow
MINIO_ROOT_USER=formflow
MINIO_ROOT_PASSWORD=formflow-secret
# Dirección pública de la web, usada en los enlaces que se envían por email
WEB_PUBLIC_URL=http://localhost:3000
# SMTP para emails (enlaces mágicos, invitaciones, acuses). Vacío = se escriben en el log de la API
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=FormFlow <no-reply@tu-dominio.com>
# Cuenta inicial del panel (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@formflow.local
ADMIN_PASSWORD=cambiame123
# Token compartido entre la API y el servicio de prueba de vida (face/)
FACE_TOKEN=cambia-este-token
